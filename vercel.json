{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/home-4-store/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop/",
      "destination": "/dyqani/",
      "permanent": true
    },
    {
      "source": "/dyqani-online/",
      "destination": "/dyqani/",
      "permanent": true
    },
    {
      "source": "/cart/",
      "destination": "/dyqani/",
      "permanent": true
    },
    {
      "source": "/checkout/",
      "destination": "/dyqani/",
      "permanent": true
    },
    {
      "source": "/my-account/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin/",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/aplikimi/",
      "destination": "/apliko/",
      "permanent": true
    },
    {
      "source": "/product-category/arme-te-shkurta/:path*",
      "destination": "/dyqani/?kategoria=arme-te-shkurta",
      "permanent": true
    },
    {
      "source": "/product-category/arme-te-gjata/:path*",
      "destination": "/dyqani/?kategoria=arme-te-gjata",
      "permanent": true
    },
    {
      "source": "/product-category/shotgune/:path*",
      "destination": "/dyqani/?kategoria=shotgune",
      "permanent": true
    },
    {
      "source": "/product-category/municione/:path*",
      "destination": "/dyqani/?kategoria=municione",
      "permanent": true
    },
    {
      "source": "/product-category/optika/:path*",
      "destination": "/dyqani/?kategoria=optika",
      "permanent": true
    },
    {
      "source": "/product-category/aksesore-veshje-taktike/:path*",
      "destination": "/dyqani/?kategoria=aksesore-veshje-taktike",
      "permanent": true
    },
    {
      "source": "/product-category/te-tjera/:path*",
      "destination": "/dyqani/?kategoria=arme-te-shkurta",
      "permanent": true
    },
    {
      "source": "/product/:path*",
      "destination": "/dyqani/",
      "permanent": true
    },
    {
      "source": "/product-category/:path*",
      "destination": "/dyqani/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' https://*.supabase.co; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(img|video|fonts|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
